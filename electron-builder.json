{
  "appId": "com.tcl.mc.pc",
  "productName": "TurboCraft Launcher - PC Edition",
  "executableName": "TurboCraftLauncher",
  "copyright": "Copyright (C) 2026 TCL Team (GPL-3.0)",
  "directories": {
    "buildResources": "build-resources",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "icon": "build-resources/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "unicode": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TurboCraft Launcher",
    "artifactName": "TurboCraft-Launcher-PC-${version}-Setup-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "TurboCraft-Launcher-PC-${version}-Portable-${arch}.${ext}"
  },
  "linux": {
    "icon": "build-resources/icon.png",
    "maintainer": "TCL Team <team@turbocraft.app>",
    "category": "Game",
    "synopsis": "TurboCraft Launcher - Modern Minecraft: Java Edition Launcher for PC",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "TurboCraft-Launcher-PC-${version}-Linux-${arch}.${ext}"
  },
  "mac": {
    "icon": "build-resources/icon.png",
    "category": "public.app-category.games",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "artifactName": "TurboCraft-Launcher-PC-${version}-macOS-${arch}.${ext}"
  }
}
